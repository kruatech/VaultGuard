# macOS
.DS_Store

# Xcode
DerivedData/
build/
*.xcuserstate
xcuserdata/
*.moved-aside
*.xccheckout
*.xcscmblueprint

# Swift Package Manager (also covers Packages/Argon2/.swiftpm, which Xcode creates when it
# opens the local package). .build/ appears if the package is built with `swift build`.
.swiftpm/
.build/
# Left behind by an old workaround that cloned packages into the project directory.
.spm/

# Local signing (per-developer Apple Team ID — never commit)
Config/Signing.local.xcconfig

# Generated sample/review databases and local KeePass backups
# (test fixtures under VaultGuardTests/ are tracked explicitly and unaffected)
docs/review/
*.kdbx.bak

# XcodeGen-generated project (source of truth is project.yml).
# There are no remote Swift packages, so there is no Package.resolved to track; CI fails if
# one appears with pins in it.
VaultGuard.xcodeproj/project.pbxproj
VaultGuard.xcodeproj/xcshareddata/xcschemes/

# Local release verification output
vaultguard_release_evidence.txt
