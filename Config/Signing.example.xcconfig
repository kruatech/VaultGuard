// Signing.example.xcconfig
//
// TEMPLATE for local code signing. Copy this file to Config/Signing.local.xcconfig
// and set your Apple Team ID:
//
//     cp Config/Signing.example.xcconfig Config/Signing.local.xcconfig
//
// Config/Signing.local.xcconfig is git-ignored and must NEVER be committed.
// It is included optionally by Config/Signing.xcconfig via `#include?`, so a
// missing local file does not break unsigned CI builds.
//
// Replace the value below with your 10-character Apple Team ID
// (Apple Developer portal > Membership > Team ID, e.g. A1B2C3D4E5).
// It is NOT your name and NOT your Apple ID email. Leaving it blank keeps the
// project on unsigned builds.

DEVELOPMENT_TEAM =
