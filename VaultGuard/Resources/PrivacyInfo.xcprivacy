<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- VaultGuard does not track users across apps/websites owned by other companies. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- VaultGuard collects no data. In local KDBX mode the vault never leaves the device;
	     in server mode vault data is end-to-end encrypted and sent only to the user-provided
	     server. The developer operates no hosted service and receives nothing. This matches
	     App Store Connect App Privacy: "Data Not Collected". -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- Required-reason APIs used by the app. Verified against the source: only UserDefaults
	     (incl. @AppStorage and the App Group suite) is used; no file-timestamp, disk-space,
	     system-boot-time, or active-keyboard APIs are present.
	     CA92.1 = access user defaults accessible only to the app/extension group. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
